# Emo configuration (.env)
# Generate random secrets via `make init`

# Public address (needed for cookies, Web Push, and emails): an origin, no path
# and no trailing slash. `make init DOMAIN=emo.example.org` sets https://DOMAIN
BASE_URL=http://localhost:8080

# HTTPS: "https" also starts Caddy on ports 80 and 443 with a Let's Encrypt
# certificate for BASE_URL's host (its DNS must point to this server first).
# `make init DOMAIN=...` sets it. Leave it commented out behind a proxy of your
# own (ops.md §2.3)
# COMPOSE_PROFILES=https

# The port the app answers on, inside the container and at 127.0.0.1 on the
# host: a proxy of your own points there (ops.md §2.3)
PORT=8080
# The image compose runs: EMO_IMAGE for a registry image instead of the local
# build (e.g. ghcr.io/<owner>/emo; `make update` then pulls it); EMO_IMAGE_TAG
# pins a version or a commit's build, default latest (rollback: ops.md §3.2)
# EMO_IMAGE=
# EMO_IMAGE_TAG=0.1.0
# The image sets DATA_DIR=/data. `make dev` (and admin targets with DEV=1) override
# PORT, BASE_URL and DATA_DIR inline: http://localhost:8081 and ./data-dev
# DATA_DIR=/data

# Secrets (generate with `openssl rand -hex 32`)
SERVER_SECRET=

# Web Push (VAPID): `make init` fills these; for an existing .env run `make vapid-keys`.
# Changing them ends every push subscription.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# SMTP email delivery: port 465 needs SMTP_SECURE=true (implicit TLS); 587 needs
# SMTP_SECURE=false and the server then requires STARTTLS.
# `make dev` (DEV_MODE) prints every mail to its terminal instead, even with
# SMTP_HOST set, so a local sign-in never mails a real address. DEV_MAIL=smtp
# sends dev mail through SMTP_HOST after all.
# DEV_MAIL=smtp
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Emo <noreply@example.com>"

# Features and policies
# Who may create an account: "open" (anyone with an email; an invite code is
# optional and still counted) or "invite" (only with an invite code)
REGISTRATION=open
INVITES_BY_USERS=true
INVITES_PER_USER=5
RECOVERY_MAIL_ENABLED=true
DEFAULT_LOCALE=en
LOG_LEVEL=info
# Whose X-Forwarded-For counts for per-IP limits: "private" (loopback and
# private ranges: the proxy of compose.yml), "none", or exact addresses
TRUSTED_PROXIES=private

# Required for `make backup`: where the .env copies go (mode 600), never inside
# DATA_DIR. `make init` sets ~/emo-env-backups
BACKUP_ENV_DIR=

# Monitoring (ops.md §5.2): a healthchecks.io check's ping URL. `make cron`
# then pings it every 5 minutes while BASE_URL answers and the newest backup is
# under 26 h old; the check mails you when the pings stop
PING_URL=

# Smoke test email
SMOKE_EMAIL=smoke@example.com

# Legal and AGPL requirements (ops.md §2.6 before inviting other people)
# Where users get the source of this exact version (AGPL §13). Empty: the
# server offers its own build's archive at /source.tar.gz (`make build` and the
# image carry one). Set it only to point at a public repository instead.
SOURCE_URL=
CRISIS_URL=https://findahelpline.com
# /privacy.html is the built-in notice (client/public/privacy.html: review it,
# edit it if you run things differently), or give your own page's URL
PRIVACY_NOTICE_URL=
# Email or other contact, shown in About and on the sign-in screen
OPERATOR_CONTACT=

# On your own machine only: the server `make deploy` and `make backup-pull`
# reach over ssh, and its checkout
# DEPLOY_HOST=root@emo.example.org
# DEPLOY_DIR=/srv/emo
