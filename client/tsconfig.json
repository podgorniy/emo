{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "types": []
  },
  "include": ["src/**/*.ts", "src/**/*.svelte", "../shared/**/*.ts"],
  "exclude": [
    "src/**/*_test.ts",
    "../shared/**/*_test.ts",
    "../shared/**/*.bench.ts",
    "../shared/crypto/vectors.ts"
  ]
}
