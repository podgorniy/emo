{
  "deno": ">=2.9.6 <2.10.0",
  "nodeModulesDir": "auto",
  "compilerOptions": {
    "lib": [
      "deno.ns",
      "deno.window",
      "dom",
      "dom.iterable",
      "esnext"
    ]
  },
  "imports": {
    "@capsizecss/core": "npm:@capsizecss/core@4.1.3",
    "@capsizecss/metrics": "npm:@capsizecss/metrics@4.3.0",
    "@hono/hono": "jsr:@hono/hono@^4.7.4",
    "@negrel/webpush": "jsr:@negrel/webpush@^0.4.0",
    "@std/assert": "jsr:@std/assert@^1.0.11",
    "@std/fs": "jsr:@std/fs@^1.0.14",
    "@std/path": "jsr:@std/path@^1.0.8",
    "@sveltejs/vite-plugin-svelte": "npm:@sveltejs/vite-plugin-svelte@^5.0.3",
    "@types/nodemailer": "npm:@types/nodemailer@7.0.2",
    "axe-core": "npm:axe-core@4.14.0",
    "fake-indexeddb": "npm:fake-indexeddb@6.2.2",
    "hash-wasm": "npm:hash-wasm@^4.12.0",
    "lighthouse": "npm:lighthouse@13.5.0",
    "nodemailer": "npm:nodemailer@7.0.9",
    "playwright-core": "npm:playwright-core@1.58.2",
    "puppeteer-core": "npm:puppeteer-core@25.12.0",
    "svelte": "npm:svelte@^5.20.2",
    "svelte-check": "npm:svelte-check@4.3.4",
    "typescript": "npm:typescript@5.9.3",
    "vite": "npm:vite@^6.2.0"
  },
  "tasks": {
    "build:client": "deno run -A --node-modules-dir=auto npm:vite build client",
    "build:server": "deno compile -A --node-modules-dir=none --exclude-unused-npm --include client/dist --include server/db/schema --output bin/emo server/main.ts",
    "pack:source": "deno run -A tools/pack_source.ts",
    "build": "deno task build:client && deno task pack:source && deno task check:budget && deno task build:server",
    "check:budget": "deno run -A perf/check_budget.ts",
    "dev:client": "deno run -A --node-modules-dir=auto npm:vite client",
    "test": "LOG_LEVEL=warn deno test -A",
    "check:client": "deno run -A npm:svelte-check@4.3.4 --workspace client --tsconfig ./tsconfig.json --fail-on-warnings=false"
  }
}
